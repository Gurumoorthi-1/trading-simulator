# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/stock_trading_db

# JWT Secret (Change this to a strong secret in production!)
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d

# Server Config
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Config (Nodemailer - Use Gmail or any SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=StockSim <your_email@gmail.com>

# Initial Balance for new users (in dollars)
INITIAL_BALANCE=100000

# Razorpay Test Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
